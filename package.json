{
  "name": "movie-series-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@material-ui/core": "^4.11.2",
    "@material-ui/icons": "^4.11.2",
    "@material-ui/lab": "^4.0.0-alpha.57",
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^11.1.0",
    "@testing-library/user-event": "^12.1.10",
    "axios": "^0.21.1",
    "dotenv": "8.2.0",
    "pg": "^8.23.1",
    "postcss": "^8.4.38",
    "react": "^17.0.1",
    "react-alice-carousel": "^2.2.2",
    "react-dom": "^17.0.1",
    "react-router-dom": "^5.2.0",
    "react-scripts": "4.0.1",
    "web-vitals": "^0.2.4"
  },
  "scripts": {
    "start": "node scripts/dev.cjs",
    "build": "node --openssl-legacy-provider --require ./scripts/node-compat.cjs node_modules/react-scripts/scripts/build.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "start:rooms": "node server/index.cjs",
    "start:production": "node server/index.cjs --serve-build",
    "test:rooms": "node --test server/*.test.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
